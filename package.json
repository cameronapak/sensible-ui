{
  "name": "@faith-tools/sensible-ui",
  "version": "1.2.0",
  "description": "Imagining Shadcn UI styles by default via a semantic CSS UI library",
  "author": "cameronapak",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "files": ["dist/sensible-ui.css", "dist/sensible-ui.min.css", "src/css"],
  "exports": {
    ".": "./dist/sensible-ui.css",
    "./accordion": "./src/css/entries/accordion.css",
    "./badge": "./src/css/entries/badge.css",
    "./base": "./src/css/entries/base.css",
    "./button": "./src/css/entries/button.css",
    "./card": "./src/css/entries/card.css",
    "./css": "./dist/sensible-ui.css",
    "./description-list": "./src/css/entries/description-list.css",
    "./image": "./src/css/entries/image.css",
    "./index": "./src/css/index.css",
    "./input": "./src/css/entries/input.css",
    "./item": "./src/css/entries/item.css",
    "./min": "./dist/sensible-ui.min.css",
    "./spinner": "./src/css/entries/spinner.css",
    "./table": "./src/css/entries/table.css",
    "./theme": "./src/css/theme.css",
    "./typography": "./src/css/entries/typography.css",
    "./utils": "./src/css/entries/utils.css",
    "./view-transition": "./src/css/view-transition.css"
  },
  "keywords": [
    "components",
    "component library",
    "component system",
    "ui",
    "ui kit",
    "shadcn",
    "shadcn/ui",
    "css",
    "html"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cameronapak/sensible-ui.git"
  },
  "bugs": {
    "url": "https://github.com/cameronapak/sensible-ui/issues"
  },
  "homepage": "https://sensibleui.com",
  "scripts": {
    "dev": "concurrently \"bun run dev:css\" \"bun run --hot ./index.tsx\"",
    "dev:css": "bun build --target=browser ./src/css/index.css --outfile=./dist/sensible-ui.css --watch",
    "prod": "bun run ./index.tsx",
    "build": "bun build --target=browser ./src/css/index.css --outfile=./dist/sensible-ui.css && bun build --target=browser ./src/css/index.css --outfile=./dist/sensible-ui.min.css --minify && prettier --write ./dist/sensible-ui.css",
    "build:site": "bun run build && bun run ./build-site.tsx",
    "check": "bun run typecheck && bun run build && bun run check:exports && git diff --exit-code -- dist/sensible-ui.css dist/sensible-ui.min.css",
    "check:exports": "bun run ./check-css-exports.ts",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "changeset:version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/bun": "^1.3.10",
    "concurrently": "^9.2.1",
    "hono": "^4.13.9",
    "prettier": "^3.8.1",
    "typescript": "5.9.3"
  }
}
